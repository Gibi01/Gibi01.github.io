{
  "name": "tp-2026",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "main": "app.js",
  "scripts": {
    "start": "node dist/app.js",
    "db:init-production": "node dist/shared/inicializar-produccion.js",
    "db:calendario": "pnpm build && node dist/shared/preparar-calendario.js",
    "db:especialidades": "pnpm build && node dist/shared/cargar-especialidades.js",
    "db:iconos": "pnpm build && node dist/shared/agregar-iconos-especialidades.js",
    "build": "tsc -p ./tsconfig.json",
    "db:prepare": "pnpm build && node dist/shared/preparar-db.js",
    "db:reset": "pnpm build && node dist/shared/preparar-db.js --reset",
    "auth:admin": "pnpm build && node dist/shared/crear-admin.js",
    "dev": "tsc-watch --noClear -p ./tsconfig.json --onSuccess \"node ./dist/app.js\"",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:catalogos": "pnpm build && node dist/shared/preparar-catalogos.js"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@mikro-orm/core": "^6.6.14",
    "@mikro-orm/mysql": "6.6.14",
    "@mikro-orm/seeder": "6.6.14",
    "@mikro-orm/sql-highlighter": "1.0.1",
    "better-auth": "1.7.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mikro-orm": "6.6.14",
    "morgan": "^1.10.1",
    "mysql": "2.18.1",
    "mysql2": "3.22.3",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "25.6.0",
    "@types/supertest": "^7.2.1",
    "morgan": "^1.10.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "tsc-watch": "6.0.4",
    "typescript": "5.1.3",
    "vitest": "^4.1.10"
  }
}
